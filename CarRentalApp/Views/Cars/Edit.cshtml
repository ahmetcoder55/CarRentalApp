@model CarRentalApp.Dtos.CreateCarDto
@{
    ViewData["Title"] = "Araç Düzenle";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4>✏️ Araç Bilgilerini Güncelle</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@ViewBag.CarId" method="post">
                <div class="mb-3">
                    <label class="form-label">Marka</label>
                    <input asp-for="Brand" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Model</label>
                    <input asp-for="Model" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Yıl</label>
                    <input asp-for="Year" type="number" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Günlük Fiyat (₺)</label>
                    <input asp-for="DailyPrice" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">⬅️ Listeye Dön</a>
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>